# CyberShield Global config (private - never upload to GitHub)
PORT=3100
NODE_ENV=production
# PostgreSQL (if it cannot connect, app auto-uses data/db.json)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cybershield
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_SSL=false
# JWT_SECRET is auto-generated in data/secret if empty
JWT_SECRET=

# ---- AI (Ollama) ----
OLLAMA_URL=http://127.0.0.1:11434
# auto = use the best installed model that fits your free RAM (recommended).
# If the chosen model cannot load (not enough RAM), CyberShield silently falls back to a smaller one.
OLLAMA_MODEL=auto
# OLLAMA_MODEL=gemma3:4b
# Small safety-net model (gemma3:1b, ~800MB) downloads by itself when the big model does not fit in RAM.
# Set OLLAMA_AUTOPULL=never to turn this off.
OLLAMA_AUTOPULL=1
# Cloud Ollama instead of local (no RAM needed on your PC):
# OLLAMA_URL=https://ollama.com
# OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_API_KEY=your_key
